{
  "name": "sierra-lighting",
  "version": "2.0.1",
  "private": true,
  "description": "sierra lighting gatsby website built with strapi as the cms",
  "author": {
    "name": "Riley Bathurst",
    "email": "riley@rileybathurst.com",
    "url": "https://rileybathurst.com"
  },
  "homepage": "https://sierra.lighting",
  "repository": "github:rileybathurst/sierra-lighting",
  "license": "MIT",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "tsc --noEmit && stay-gold && gatsby develop",
    "fullstart": "blc http://sierra.lighting --exclude '*yelp*' --exclude '*tiktok*' && pa11y http://sierra.lighting && tsc --noEmit && stay-gold && gatsby develop",
    "dirty": "gatsby develop",
    "build": "tsc --noEmit && stay-gold && gatsby build",
    "build-dirty": "gatsby build",
    "clean-build": "gatsby clean && gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "storybook": "tsc --noEmit && stay-gold && storybook dev -p 6006",
    "storybook-dirty": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org riley-bathurst-design --project javascript-gatsby ./public && sentry-cli sourcemaps upload --org riley-bathurst-design --project javascript-gatsby ./public",
    "stay-gold": "stay-gold"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@fontsource-variable/josefin-sans": "^5.3.0",
    "@fontsource/biz-udpmincho": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@libsql/client": "^0.17.4",
    "@mux/mux-player-react": "^3.13.2",
    "@netlify/functions": "^5.3.0",
    "@sentry/cli": "^3.6.2",
    "@sentry/gatsby": "^10.70.0",
    "@storybook/addon-docs": "^10.1.10",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "@types/react-responsive-masonry": "^2.6.0",
    "dotenv": "^17.4.2",
    "gatsby": "^5.16.1",
    "gatsby-adapter-netlify": "^1.2.1",
    "gatsby-plugin-csp": "^1.1.4",
    "gatsby-plugin-image": "^3.14.0",
    "gatsby-plugin-manifest": "^5.14.0",
    "gatsby-plugin-sharp": "^5.14.0",
    "gatsby-plugin-sitemap": "^6.14.0",
    "gatsby-source-filesystem": "^5.14.0",
    "gatsby-source-strapi": "^5.0.4",
    "gatsby-transformer-sharp": "^5.14.0",
    "js-search": "^2.0.1",
    "masonry-layout": "^4.2.2",
    "react": "^18.3.1",
    "react-aria-components": "^1.20.0",
    "react-dom": "^18.3.1",
    "react-inlinesvg": "^4.5.0",
    "react-markdown": "^10.1.0",
    "react-responsive-masonry": "^2.7.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "stay-gold": "^1.5.6",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@chromatic-com/storybook": "^5.3.0",
    "@faker-js/faker": "^10.1.0",
    "@mdx-js/react": "^3.1.0",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/react-webpack5": "^10.5.7",
    "@types/js-search": "^1.4.4",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/mocker": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "gatsby-plugin-postcss": "^6.14.0",
    "postcss": "^8.5.26",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^8.0.1",
    "prop-types": "^15.8.1",
    "storybook": "^10.5.7",
    "style-loader": "^4.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
